# =============================================================================
# stack-spiderfoot-docker.env.example
#
# Template only — tracked in git, no real secrets. Copy to
# stack-spiderfoot-docker.env and fill in every CHANGE_ME before running
# `docker compose --env-file stack-spiderfoot-docker.env ...` — that file
# is gitignored and must never be committed.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=spiderfoot
POSTGRES_USER=spiderfoot
POSTGRES_PASSWORD=CHANGE_ME

# --- API / scanner ---
SF_API_WORKERS=2
SF_API_KEY=
SF_LOG_LEVEL=INFO
CELERY_WORKER_CONCURRENCY=4

# --- Auth ---
SF_JWT_SECRET=CHANGE_ME
SF_ADMIN_USERNAME=admin
SF_ADMIN_PASSWORD=CHANGE_ME

# --- MinIO ---
MINIO_ROOT_USER=spiderfoot
MINIO_ROOT_PASSWORD=CHANGE_ME

# --- Qdrant ---
# Upstream defaults SF_QDRANT_BACKEND to "memory" (ephemeral, always empty)
# when unset — these three are the fix, and are also hardcoded directly in
# the compose file itself as of 1.6.0 (no unsafe fallback), kept here too
# for visibility.
SF_QDRANT_BACKEND=http
SF_QDRANT_HOST=qdrant
SF_QDRANT_PORT=6333
SF_QDRANT_GRPC_PORT=6334

# --- Embeddings ---
# Local CPU model (fastembed, onnxruntime-backed), no external API key
# needed — matches prod's "no external embedding dependency" stance.
# Also hardcoded directly in the compose file as of 1.6.0.
SF_EMBEDDING_PROVIDER=fastembed
SF_EMBEDDING_MODEL=all-MiniLM-L6-v2
SF_EMBEDDING_DIMENSIONS=384
SF_EMBEDDING_API_KEY=
SF_EMBEDDING_API_BASE=

# --- LiteLLM proxy (fronts Anthropic Claude Sonnet 5 via litellm-config.yaml) ---
# Leave SF_LLM_PROVIDER=mock (the compose file's own default) to run
# without any LLM calls at all — AI reports will use a stub response
# instead of a real one. Set ANTHROPIC_API_KEY and switch SF_LLM_PROVIDER
# to openai (litellm's own OpenAI-compatible passthrough, not literally
# OpenAI — see litellm-config.yaml) for real reports.
LITELLM_MASTER_KEY=CHANGE_ME
ANTHROPIC_API_KEY=CHANGE_ME
SF_LLM_PROVIDER=mock
SF_LLM_MODEL=spiderfoot-llm
SF_LLM_API_BASE=http://litellm:4000
SF_LLM_API_KEY=CHANGE_ME
LITELLM_CPUS=1.0
LITELLM_MEMORY=512M

# --- Agents ---
SF_AGENTS_WORKERS=1
AGENTS_CPUS=2.0
AGENTS_MEMORY=2G

# --- AI report generation ---
# Max scan events embedded/analysed per report. Was hardcoded at 500 with
# no way to raise it (a real 687-event scan was silently truncated) -
# configurable since, but stayed unset here until 2026-09-17, so it kept
# defaulting to 500 anyway. See PR #393.
SF_REPORT_MAX_EVENTS_PER_SCAN=2000

# --- Resource limits (defaults fine for local dev) ---
API_CPUS=1.0
API_MEMORY=1G
WEBUI_CPUS=0.5
WEBUI_MEMORY=256M
CELERY_WORKER_CPUS=2.0
CELERY_WORKER_MEMORY=2G
CELERY_ACTIVE_WORKER_CPUS=2.0
CELERY_ACTIVE_WORKER_MEMORY=2G
MINIO_CPUS=1.0
MINIO_MEMORY=512M
QDRANT_CPUS=1.0
QDRANT_MEMORY=1G
TIKA_HEAP=512m
TIKA_CPUS=1.0
TIKA_MEMORY=1G
