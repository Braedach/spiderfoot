# =============================================================================
# deploy/stack-docker.env.example
#
# Template only - tracked in git, no real secrets. For the Docker
# development/sandbox deployment (claude). Copy it to
# /srv/spiderfoot/stack-spiderfoot-env.env and replace every CHANGE_ME.
# Same variables as stack-podman.env.example, deliberately - see that file
# for the notes on how each secret behaves. Generation commands for each
# secret are in deploy/README.md.
#
# Use DIFFERENT secrets on claude and baden. The dev stack must never hold
# production credentials.
# =============================================================================

TZ=Australia/Perth

# --- PostgreSQL ---
POSTGRES_USER=spiderfoot
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=spiderfoot

# --- Image tag (REQUIRED - the stack refuses to start without it) ---
# An exact tag published by deploy/publish.sh. This is where a branch is
# tested: set it to the -rc tag (e.g. v6.1.0-bd.1-rc.1), then to the release
# tag once that has soaked. There is deliberately no default and :latest
# is not used:
# the old <version>-g<sha> tags are retired. Browse published tags at
# https://github.com/Braedach?tab=packages
SPIDERFOOT_TAG=

# --- Core service config ---
SF_DEPLOYMENT_MODE=microservices
SF_DATABASE_URL=postgresql://spiderfoot:CHANGE_ME@sf-postgres:5432/spiderfoot
SF_REDIS_URL=redis://sf-redis:6379
SF_LOG_FORMAT=json

# --- Auth secrets ---
SF_JWT_SECRET_KEY=CHANGE_ME
SF_ADMIN_PASSWORD=CHANGE_ME

# --- AI agents / LiteLLM shared secret ---
# Same value used as litellm's LITELLM_MASTER_KEY and sf-agents' own
# SF_LLM_API_KEY — authenticates agents' calls to the litellm proxy.
SF_LLM_API_KEY=CHANGE_ME

# --- Anthropic (fronts Claude Sonnet 5 via litellm-config.yaml) ---
# Entered directly as its own environment variable at deploy
# time in practice — this line is documentation of what's needed, not
# how it's actually supplied.
ANTHROPIC_API_KEY=CHANGE_ME

# --- Compose profiles enabled on startup ---
COMPOSE_PROFILES=scan

# --- AI report generation ---
# Max scan events embedded/analysed per report. Was hardcoded at 500 with
# no way to raise it (a real 687-event scan was silently truncated) -
# configurable since, but stayed unset here until 2026-09-17, so it kept
# defaulting to 500 anyway. See PR #393.
SF_REPORT_MAX_EVENTS_PER_SCAN=2000
