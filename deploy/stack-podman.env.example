# =============================================================================
# deploy/stack-podman.env.example   (was stack-spiderfoot-podman.env.example)
#
# Template only - tracked in git, no real secrets. Copy it to
# /srv/spiderfoot/stack-spiderfoot-env.env on baden and replace every
# CHANGE_ME. (That filename predates this project's "-podman" naming; left
# as-is because the running deployment already depends on it.) Generation
# commands for each secret are in deploy/README.md.
#
# bootstrap-spiderfoot-env.sh, which older versions of this file told you to
# run, does not exist anywhere (not in this repo, not on baden). Do not look
# for it.
#
# POSTGRES_PASSWORD is applied by the postgres image only when its data
# directory is first initialised and is repeated inside SF_DATABASE_URL, so
# changing it in this file later does NOT change the database role's
# password - the two must be changed together, by hand, inside postgres.
# SF_LLM_API_KEY must be identical for litellm and sf-agents. What changing
# SF_JWT_SECRET_KEY and SF_ADMIN_PASSWORD does to an already-running
# deployment has not been verified [VERIFY] - treat all four as generate-once.
# =============================================================================

TZ=Australia/Perth

# --- PostgreSQL ---
POSTGRES_USER=spiderfoot
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=spiderfoot

# --- Image tag (REQUIRED - the stack refuses to start without it) ---
# An exact tag published by deploy/publish.sh, e.g. v6.1.0-bd.1 for a release
# or v6.1.0-bd.1-rc.1 for a test build. Production (baden) pins an exact
# release tag. There is deliberately no default and :latest is not used:
# the old <version>-g<sha> tags are retired. Browse published tags at
# https://github.com/Braedach?tab=packages
SPIDERFOOT_TAG=

# --- Core service config ---
SF_DEPLOYMENT_MODE=microservices
SF_DATABASE_URL=postgresql://spiderfoot:CHANGE_ME@sf-postgres:5432/spiderfoot
SF_REDIS_URL=redis://sf-redis:6379
SF_LOG_FORMAT=json

# --- Auth secrets ---
SF_JWT_SECRET_KEY=CHANGE_ME
SF_ADMIN_PASSWORD=CHANGE_ME

# --- AI agents / LiteLLM shared secret ---
# Same value used as litellm's LITELLM_MASTER_KEY and sf-agents' own
# SF_LLM_API_KEY — authenticates agents' calls to the litellm proxy.
SF_LLM_API_KEY=CHANGE_ME

# --- Anthropic (fronts Claude Sonnet 5 via litellm-config.yaml) ---
# Entered directly as its own Dockhand environment variable at deploy
# time in practice — this line is documentation of what's needed, not
# how it's actually supplied on baden.
ANTHROPIC_API_KEY=CHANGE_ME

# --- Compose profiles enabled on startup ---
COMPOSE_PROFILES=scan

# --- AI report generation ---
# Max scan events embedded/analysed per report. Was hardcoded at 500 with
# no way to raise it (a real 687-event scan was silently truncated) -
# configurable since, but stayed unset here until 2026-09-17, so it kept
# defaulting to 500 anyway. See PR #393.
SF_REPORT_MAX_EVENTS_PER_SCAN=2000
