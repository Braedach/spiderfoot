# =============================================================================
# deploy/stack-podman.env.example   (was stack-spiderfoot-podman.env.example)
#
# Template only - tracked in git, no real secrets. Normally you do not copy
# this by hand: run deploy/bootstrap-spiderfoot-env.sh, which generates the
# real file at /srv/spiderfoot/stack-spiderfoot-env.env with fresh secrets
# (that filename predates this project's "-podman" naming; left as-is because
# the running deployment already depends on it). This file documents what
# that script produces, and is what to copy from if you must do it by hand.
#
# POSTGRES_PASSWORD, SF_JWT_SECRET_KEY and SF_ADMIN_PASSWORD
# are generate-once; rotating them by hand has consequences (from the
# script's own documentation):
#   - POSTGRES_PASSWORD: postgres applies it only at first initdb, and it is
#     repeated inside SF_DATABASE_URL, so changing it here later does NOT
#     change the database role's password and breaks auth. Change both
#     together, inside postgres too.
#   - SF_JWT_SECRET_KEY: rotating it invalidates every session.
#   - SF_ADMIN_PASSWORD: rotating it locks you out of the UI until you find
#     the new value.
# =============================================================================

TZ=Australia/Perth

# --- PostgreSQL ---
POSTGRES_USER=spiderfoot
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=spiderfoot

# --- Image tag (REQUIRED - the stack refuses to start without it) ---
# An exact tag published by deploy/publish.sh, e.g. v6.1.0-bd.1 for a release
# or v6.1.0-bd.1-rc.1 for a test build. Production (baden) pins an exact
# release tag. There is deliberately no default and :latest is not used:
# the old <version>-g<sha> tags are retired. Browse published tags at
# https://github.com/Braedach?tab=packages
SPIDERFOOT_TAG=

# --- Core service config ---
SF_DEPLOYMENT_MODE=microservices
SF_DATABASE_URL=postgresql://spiderfoot:CHANGE_ME@sf-postgres:5432/spiderfoot
SF_REDIS_URL=redis://sf-redis:6379
SF_LOG_FORMAT=json

# --- Auth secrets ---
SF_JWT_SECRET_KEY=CHANGE_ME
SF_ADMIN_PASSWORD=CHANGE_ME

# --- Anthropic (sf-agents calls Claude directly; model via SF_LLM_MODEL, default claude-sonnet-5-5) ---
# Sonnet 5.5's safeguards may decline cyber-flavoured input .
# The API retries a declined request on another model (SF_LLM_FALLBACK, on by default). See deploy/README.md "AI model".
# Entered directly as its own Dockhand environment variable at deploy
# time in practice — this line is documentation of what's needed, not
# how it's actually supplied on baden.
ANTHROPIC_API_KEY=CHANGE_ME

# --- Compose profiles enabled on startup ---
COMPOSE_PROFILES=scan

# --- AI report generation ---
# Max scan events embedded/analysed per report. Was hardcoded at 500 with
# no way to raise it (a real 687-event scan was silently truncated) -
# configurable since, but stayed unset here until 2026-09-17, so it kept
# defaulting to 500 anyway. See PR #393.
SF_REPORT_MAX_EVENTS_PER_SCAN=2000
