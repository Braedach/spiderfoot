# =============================================================================
# stack-spiderfoot-podman.env.example
#
# Template only — tracked in git, no real secrets. On baden itself, run
# ./bootstrap-spiderfoot-env.sh to generate the real file at
# /srv/spiderfoot/stack-spiderfoot-env.env (that script's own output
# filename predates this project's "-podman" naming convention; left
# as-is rather than migrating a filename an already-running deployment
# depends on for no operational benefit).
#
# POSTGRES_PASSWORD, SF_JWT_SECRET_KEY, SF_ADMIN_PASSWORD and SF_LLM_API_KEY
# are generated once by that script and never rotated — see its own header
# for exactly why each one breaks something if you rotate it by hand.
# =============================================================================

TZ=Australia/Perth

# --- PostgreSQL ---
POSTGRES_USER=spiderfoot
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=spiderfoot

# --- Image tag. GHCR builds are now automated via .github/workflows/docker.yml
# (previously this said "never :latest" — that was written back when nothing
# was actually publishing :latest reliably. Now that CI builds and pushes it
# on every release, :latest pairs with this stack's Watchtower labels for
# auto-updates. Pin to an exact sha tag instead (see
# https://github.com/braedach?tab=packages) if you want to hold a build back. ---
SPIDERFOOT_TAG=latest

# --- Core service config ---
SF_DEPLOYMENT_MODE=microservices
SF_DATABASE_URL=postgresql://spiderfoot:CHANGE_ME@sf-postgres:5432/spiderfoot
SF_REDIS_URL=redis://sf-redis:6379
SF_LOG_FORMAT=json

# --- Auth secrets ---
SF_JWT_SECRET_KEY=CHANGE_ME
SF_ADMIN_PASSWORD=CHANGE_ME

# --- AI agents / LiteLLM shared secret ---
# Same value used as litellm's LITELLM_MASTER_KEY and sf-agents' own
# SF_LLM_API_KEY — authenticates agents' calls to the litellm proxy.
SF_LLM_API_KEY=CHANGE_ME

# --- Anthropic (fronts Claude Sonnet 5 via litellm-config-podman.yaml) ---
# Entered directly as its own Portainer environment variable at deploy
# time in practice — this line is documentation of what's needed, not
# how it's actually supplied on baden.
ANTHROPIC_API_KEY=CHANGE_ME

# --- Compose profiles enabled on startup ---
COMPOSE_PROFILES=scan

# --- AI report generation ---
# Max scan events embedded/analysed per report. Was hardcoded at 500 with
# no way to raise it (a real 687-event scan was silently truncated) -
# configurable since, but stayed unset here until 2026-09-17, so it kept
# defaulting to 500 anyway. See PR #393.
SF_REPORT_MAX_EVENTS_PER_SCAN=2000
