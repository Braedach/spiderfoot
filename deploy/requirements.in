# deploy/requirements.in - input for deploy/requirements.lock (see the header there).
# The project's own requirements, plus the embedding backend that
# docker/Dockerfile.base used to install separately and unpinned.
-r ../requirements.txt
fastembed>=0.7.0,<1.0.0

# pip itself, locked with hashes like everything else. The python:3.12-slim image
# bundles pip 25.0.1, which has five published advisories (fixed by 26.2.1). The
# venv inherits whatever pip it was created with, so lock it here (needs
# `uv pip compile --allow-unsafe` to be emitted into the lock).
pip==26.2.1
