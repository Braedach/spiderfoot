# =============================================================================
# deploy/docker/Dockerfile.base
# Version: 1.0.0
# Created: 2026-10-23
#
# Fork-owned replacement for docker/Dockerfile.base (upstream's file is left
# untouched, so upstream merges never conflict with this). Built by
# deploy/publish.sh with the repository root as the build context. The api,
# scanner and active-scanner images build FROM this one; sf-agents runs it
# directly. Revisit if upstream resumes committing (none since 2026-06-02).
#
# Same layout and behaviour as upstream's. What changed, and why:
#
#   - Python 3.11 on Debian 12 -> Python 3.12 on Debian 13 (trixie). Debian 12
#     left regular security support on 2026-07-11. 3.12 is what upstream's CI
#     already tests; 3.13+ is untested here.
#   - Python dependencies come from deploy/requirements.lock: every package
#     pinned to an exact version AND hash (`pip install --require-hashes`).
#     The old build installed ranges (56 of 60 requirements) with no hashes, so
#     the image depended on the day it was built, not the commit. See the lock's
#     inputs: deploy/requirements.in and deploy/requirements-overrides.txt.
#   - fastembed (CPU) is part of that lock instead of an unpinned second
#     `pip install`. The GPU_ACCEL=1 / fastembed-gpu variant is NOT supported
#     here yet: it would need its own lock. Re-add it with one when needed.
#   - The package database is kept. Upstream deleted /var/lib/dpkg, which also
#     blinded vulnerability scanners: the old base image scanned "0 OS-package
#     findings" only because there was nothing to read. Package managers are
#     still removed (apt, dpkg binaries) so nothing can be installed at runtime;
#     only the read-only status file stays so the image can be scanned.
#   - pip removed from the runtime image (see the RUN below the venv copy).
#   - curl dropped: nothing in the application calls it (the stack's
#     healthchecks use Python), and curl is a frequent CVE source.
#   - The base image is pinned by digest (see Dockerfile.frontend for the
#     refresh procedure and why base images are not subject to the 14-day
#     release cool-down).
#
# Pinned 2026-10-23: python 3.12.15 on Debian 13.
#
# Build (from the repository root):
#   docker build -f deploy/docker/Dockerfile.base -t spiderfoot-base:test .
# =============================================================================

# -- Stage 1: install the locked Python dependencies --------------------------
FROM python:3.12-slim-trixie@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704 AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc build-essential libxml2-dev libxslt-dev libjpeg-dev \
    zlib1g-dev libffi-dev libssl-dev python3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# --require-hashes refuses anything not in the lock with a matching hash;
# --no-deps because the lock is already complete (no second resolution).
COPY deploy/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir --require-hashes --no-deps -r requirements.lock

# -- Stage 2: runtime base -----------------------------------------------------
FROM python:3.12-slim-trixie@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704

LABEL org.opencontainers.image.title="SpiderFoot Base" \
      org.opencontainers.image.description="Shared base for SpiderFoot microservices"

# Runtime-only system libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    libxml2 libxslt1.1 libjpeg62-turbo zlib1g \
    dnsutils ca-certificates \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy the locked venv from the builder
COPY --from=builder /opt/venv /opt/venv

# Remove pip from the runtime image, in the venv AND the base image's own copy.
# The builder stage installs everything; the running services never install
# anything, so a package installer here is only attack surface. It was also the
# source of scanner noise: pip bundles private copies of urllib3, certifi,
# msgpack and setuptools (pip/_vendor), which scanners flag as vulnerable
# packages although nothing at runtime uses them. (A downstream image that must
# pip install at build time needs its own builder stage, not this venv's pip.)
RUN rm -rf /opt/venv/lib/python3.12/site-packages/pip /opt/venv/lib/python3.12/site-packages/pip-*.dist-info \
           /opt/venv/bin/pip /opt/venv/bin/pip3 /opt/venv/bin/pip3.12 \
           /usr/local/lib/python3.12/site-packages/pip /usr/local/lib/python3.12/site-packages/pip-*.dist-info \
           /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.12

ENV PATH="/opt/venv/bin:$PATH" \
    VIRTUAL_ENV="/opt/venv" \
    PYTHONPATH="/home/spiderfoot" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPYCACHEPREFIX="/tmp/__pycache__"

# Create non-root user
RUN addgroup --system spiderfoot && \
    adduser --system --ingroup spiderfoot --home /home/spiderfoot \
            --shell /usr/sbin/nologin --gecos "SpiderFoot" spiderfoot

WORKDIR /home/spiderfoot

# Copy application source
COPY --chown=spiderfoot:spiderfoot spiderfoot/  spiderfoot/
COPY --chown=spiderfoot:spiderfoot modules/     modules/
COPY --chown=spiderfoot:spiderfoot correlations/ correlations/
COPY --chown=spiderfoot:spiderfoot sfapi.py     sfapi.py
COPY --chown=spiderfoot:spiderfoot VERSION      VERSION
COPY --chown=spiderfoot:spiderfoot setup.py     setup.py
COPY --chown=spiderfoot:spiderfoot setup.cfg    setup.cfg
COPY --chown=spiderfoot:spiderfoot config/      config/

# Copy entrypoint
COPY --chown=root:root docker/docker-entrypoint.sh /usr/local/bin/
RUN sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.sh && \
    chmod +x /usr/local/bin/docker-entrypoint.sh

# Create runtime directories
RUN mkdir -p /home/spiderfoot/data /home/spiderfoot/logs \
             /home/spiderfoot/cache /home/spiderfoot/.spiderfoot/logs && \
    chown -R spiderfoot:spiderfoot /home/spiderfoot

# Ensure package init files
RUN touch /home/spiderfoot/__init__.py \
          /home/spiderfoot/modules/__init__.py \
          /home/spiderfoot/correlations/__init__.py

# -- Security hardening --------------------------------------------------------
# Remove SUID/SGID bits to prevent privilege escalation
RUN find / -xdev -perm -4000 -type f -exec chmod u-s {} + 2>/dev/null || true && \
    find / -xdev -perm -2000 -type f -exec chmod g-s {} + 2>/dev/null || true

# Remove the package managers so nothing can be installed in a compromised
# container - but KEEP /var/lib/dpkg/status: it is the list of installed
# packages that vulnerability scanners and SBOM tools read. Deleting it (as
# upstream's file did) makes an image look clean to a scanner when it is not.
RUN apt-get purge -y --auto-remove apt 2>/dev/null || true && \
    rm -rf /var/lib/apt /var/cache/apt && \
    find /var/lib/dpkg -mindepth 1 ! -name status -delete 2>/dev/null || true && \
    rm -f /usr/bin/dpkg /usr/bin/dpkg-deb /usr/bin/dpkg-query /usr/bin/dpkg-split /usr/bin/dpkg-trigger \
          /usr/bin/apt /usr/bin/apt-get /usr/bin/apt-cache /usr/bin/apt-config /usr/bin/apt-mark

# Remove unnecessary network utilities
RUN rm -f /usr/bin/wget /usr/bin/nc /usr/bin/ncat 2>/dev/null || true

USER spiderfoot

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
